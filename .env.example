# ─────────────────────────────────────────────────────────────
# Keycloak SSO — required (used by every environment)
# ─────────────────────────────────────────────────────────────
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=ph-ab
KEYCLOAK_CLIENT_ID=ph-ab-api
KEYCLOAK_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Optional per-environment overrides.
# The active connection is picked from app()->environment():
#   local → *_DEV, staging → *_STAGING, production → *_PROD.
# Any unset override falls back to the base value above.
# ─────────────────────────────────────────────────────────────
# KEYCLOAK_BASE_URL_DEV=
# KEYCLOAK_REALM_DEV=
# KEYCLOAK_CLIENT_ID_DEV=
# KEYCLOAK_CLIENT_SECRET_DEV=

# KEYCLOAK_BASE_URL_STAGING=
# KEYCLOAK_REALM_STAGING=
# KEYCLOAK_CLIENT_ID_STAGING=
# KEYCLOAK_CLIENT_SECRET_STAGING=

# KEYCLOAK_BASE_URL_PROD=
# KEYCLOAK_REALM_PROD=
# KEYCLOAK_CLIENT_ID_PROD=
# KEYCLOAK_CLIENT_SECRET_PROD=

# ─────────────────────────────────────────────────────────────
# Optional tuning (defaults shown)
# ─────────────────────────────────────────────────────────────
# KEYCLOAK_SCOPE="openid profile email"
# KEYCLOAK_HTTP_TIMEOUT=10
# KEYCLOAK_LOG_CHANNEL=stack
